@page "/ordinateurs"
@using System.Net.Http.Headers
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage

<h3>Liste des ordinateurs</h3>

@if (message != null)
{
    <p>@message</p>
}
else if (ordinateurs == null)
{
    <p>Chargement...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prix</th>
                <th>Devise</th>
                <th>Vendu</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ordinateur in ordinateurs)
            {
                <tr>
                    <td>@ordinateur.Nom</td>
                    <td>@ordinateur.Prix</td>
                    <td>EUR</td> @* le prix en base est en euros *@
                    <td>@(ordinateur.Vendu ? "Oui" : "Non")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<OrdinateurListe>? ordinateurs;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        // Le token est nécessaire : l'API est protégée par [Authorize]
        var token = await SessionStorage.GetItemAsync<string>("token");
        if (string.IsNullOrEmpty(token))
        {
            message = "Veuillez vous connecter";
            return;
        }

        // Appel via la Gateway avec le token dans l'en-tête Authorization
        var client = HttpClientFactory.CreateClient("Gateway");
        var requete = new HttpRequestMessage(HttpMethod.Get, "api/ordinateurs");
        requete.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var response = await client.SendAsync(requete);
        if (!response.IsSuccessStatusCode)
        {
            message = $"Erreur {(int)response.StatusCode}";
            return;
        }

        ordinateurs = await response.Content.ReadFromJsonAsync<List<OrdinateurListe>>();
    }

    // Seules les colonnes affichées
    private record OrdinateurListe(string Nom, decimal Prix, bool Vendu);
}
